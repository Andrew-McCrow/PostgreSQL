<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>PostgreSQL Practice</title>
  </head>
  <body>
    <h1>Usernames</h1>

    <form method="GET" action="/">
      <input type="text" name="search" value="<%= search %>" placeholder="Search usernames..." />
      <button type="submit">Search</button>
    </form>

    <ul>
      <% usernames.forEach(user => { %>
        <li><%= user.username %></li>
      <% }) %>
    </ul>
    <a href="/new">Add a Username</a>
  </body>
</html>
